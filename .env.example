# LOCAL DEVELOPMENT ONLY. Never use this password for a deployed hospital.
HMS_DB_USER=hms
HMS_DB_PASSWORD=replace_for_local_dev
HMS_DB_NAME=hms_community

# Not: PostgreSQL parolası volume İLK kez oluşturulurken atanır. Mevcut bir volume varken değiştirilirse
# backend veritabanına bağlanamaz; o durumda volume'u oluşturan değeri kullanın.

# İlk yönetici: ikisi birlikte verilirse ve sistemde hiç yönetici yoksa backend açılışında oluşturulur.
# Kullanıcı adı: küçük harf, rakam, . _ - (3-50). Parola: en az 12 karakter, en fazla 72 bayt.
# Hesap oluştuktan sonra parolayı bu dosyadan kaldırın; yönetici varken değer yeniden kullanılmaz.
HMS_BOOTSTRAP_ADMIN_USERNAME=
HMS_BOOTSTRAP_ADMIN_PASSWORD=

# Ana makine portları (yalnızca 127.0.0.1). Dolu bir port varsa değiştirin.
HMS_HTTP_PORT=80
HMS_BACKEND_PORT=8080
